# Copy this file to .env and fill in your keys. .env is gitignored.

# Jev classifier (TypeSafe). Makes every editing decision.
TYPESAFE_API_KEY=

# Groq. Used for one scene description and for writing the on-screen card text.
GROQ_API_KEY=

# Optional: send Jev requests through a LiteLLM gateway (POST /v1/decisions)
# instead of straight to TypeSafe. When LITELLM_BASE_URL is set, TYPESAFE_API_KEY
# is only needed by the gateway, not here.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Model group name on the gateway (default: jev). Direct mode default: jev-latest.
JEV_MODEL=
