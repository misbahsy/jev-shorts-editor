# Copy this file to .env and fill in your keys. .env is gitignored.

# Jev makes every editing decision through a LiteLLM gateway (POST /v1/decisions).
# The gateway holds the TypeSafe key; this app only needs the gateway URL and a key for it.
# See the README for starting the proxy with litellm.config.example.yaml.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
# Model group name on the gateway (default: jev).
JEV_MODEL=

# Groq. Used for one scene description and for writing the on-screen card text.
GROQ_API_KEY=

# Fallback without a gateway: call TypeSafe directly. Leave LITELLM_BASE_URL empty
# and set this instead. Direct mode model default: jev-latest.
TYPESAFE_API_KEY=
